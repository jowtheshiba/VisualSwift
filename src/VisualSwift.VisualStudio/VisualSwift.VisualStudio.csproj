<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>VisualSwift.VisualStudio</AssemblyName>
    <RootNamespace>VisualSwift</RootNamespace>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeAssemblyFromOutputFolderInVSIXContainer>true</IncludeAssemblyFromOutputFolderInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <UseCodebase>true</UseCodebase>
    <LicenseExpression>Apache-2.0</LicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.TemplateWizardInterface" Version="17.10.40170" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.ComponentModel.Composition" />
    <Content Include="source.extension.vsixmanifest" />
    <Content Include="VisualSwift.pkgdef"><IncludeInVSIX>true</IncludeInVSIX></Content>
    <Content Include="VisualSwift.settings.json"><IncludeInVSIX>true</IncludeInVSIX></Content>
    <Content Include="..\..\LICENSE" Link="LICENSE"><IncludeInVSIX>true</IncludeInVSIX></Content>
    <Content Include="..\..\NOTICE" Link="NOTICE"><IncludeInVSIX>true</IncludeInVSIX></Content>
    <Content Include="..\..\assets\icons\visualswift-128.png" Link="Assets\visualswift.png"><IncludeInVSIX>true</IncludeInVSIX></Content>
    <Content Include="..\..\assets\icons\visualswift.ico" Link="Assets\visualswift.ico"><IncludeInVSIX>true</IncludeInVSIX></Content>
    <Content Include="$(IntermediateOutputPath)ProjectTemplates\SwiftConsole.zip" Link="ProjectTemplates\SwiftConsole.zip"><IncludeInVSIX>true</IncludeInVSIX></Content>
    <Content Include="$(IntermediateOutputPath)ProjectTemplates\SwiftLibrary.zip" Link="ProjectTemplates\SwiftLibrary.zip"><IncludeInVSIX>true</IncludeInVSIX></Content>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\templates\SwiftConsole\Sources\App\main.swift" LogicalName="VisualSwift.Templates.Console.main.swift" />
    <EmbeddedResource Include="..\..\templates\SwiftLibrary\Sources\Library\Greeter.swift" LogicalName="VisualSwift.Templates.Library.Greeter.swift" />
    <EmbeddedResource Include="..\..\templates\SwiftLibrary\Tests\LibraryTests\GreeterTests.swift" LogicalName="VisualSwift.Templates.Library.GreeterTests.swift" />
    <EmbeddedResource Include="..\..\templates\Shared\Invoke-Swift.ps1" LogicalName="VisualSwift.Templates.Invoke-Swift.ps1" />
  </ItemGroup>
  <Target Name="BuildSwiftProjectTemplates" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <ConsoleTemplateFiles Include="$(MSBuildProjectDirectory)\..\..\templates\SwiftConsole\**\*" />
      <LibraryTemplateFiles Include="$(MSBuildProjectDirectory)\..\..\templates\SwiftLibrary\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ConsoleTemplateFiles)" DestinationFiles="@(ConsoleTemplateFiles->'$(IntermediateOutputPath)TemplateStaging\SwiftConsole\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(LibraryTemplateFiles)" DestinationFiles="@(LibraryTemplateFiles->'$(IntermediateOutputPath)TemplateStaging\SwiftLibrary\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="..\..\templates\Shared\gitignore.txt;..\..\assets\icons\swift-console.ico;..\..\templates\Shared\Invoke-Swift.ps1" DestinationFiles="$(IntermediateOutputPath)TemplateStaging\SwiftConsole\gitignore.txt;$(IntermediateOutputPath)TemplateStaging\SwiftConsole\template.ico;$(IntermediateOutputPath)TemplateStaging\SwiftConsole\VisualSwift\Invoke-Swift.ps1" />
    <Copy SourceFiles="..\..\templates\Shared\gitignore.txt;..\..\assets\icons\swift-library.ico;..\..\templates\Shared\Invoke-Swift.ps1" DestinationFiles="$(IntermediateOutputPath)TemplateStaging\SwiftLibrary\gitignore.txt;$(IntermediateOutputPath)TemplateStaging\SwiftLibrary\template.ico;$(IntermediateOutputPath)TemplateStaging\SwiftLibrary\VisualSwift\Invoke-Swift.ps1" />
    <MakeDir Directories="$(IntermediateOutputPath)ProjectTemplates" />
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)TemplateStaging\SwiftConsole" DestinationFile="$(IntermediateOutputPath)ProjectTemplates\SwiftConsole.zip" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)TemplateStaging\SwiftLibrary" DestinationFile="$(IntermediateOutputPath)ProjectTemplates\SwiftLibrary.zip" Overwrite="true" />
  </Target>
</Project>
