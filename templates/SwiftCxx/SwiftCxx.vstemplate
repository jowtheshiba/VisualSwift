<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Swift + C++ Console Application</Name>
    <Description>A SwiftPM console application calling a C++17 library, with C++ interoperability enabled. Requires C++ project support and an installed Windows Swift toolchain.</Description>
    <Icon>template.ico</Icon>
    <ProjectType>VC</ProjectType>
    <TemplateID>VisualSwift.Cxx</TemplateID>
    <DefaultName>SwiftCxx</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <CreateNewFolder>true</CreateNewFolder>
    <SortOrder>30</SortOrder>
    <LanguageTag>Swift</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Console</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project File="Swift.vcxproj" TargetFileName="$projectname$.vcxproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="Package.swift">Package.swift</ProjectItem>
      <ProjectItem ReplaceParameters="false" TargetFileName="$projectname$.vcxproj.filters">Swift.vcxproj.filters</ProjectItem>
      <ProjectItem ReplaceParameters="false" TargetFileName=".gitignore">gitignore.txt</ProjectItem>
      <ProjectItem ReplaceParameters="false" OpenInEditor="true" TargetFileName="Sources\App\main.swift">Sources\App\main.swift</ProjectItem>
      <ProjectItem ReplaceParameters="false" TargetFileName="Sources\CppMath\CppMath.cpp">Sources\CppMath\CppMath.cpp</ProjectItem><ProjectItem ReplaceParameters="false" TargetFileName="Sources\CppMath\include\CppMath.h">Sources\CppMath\include\CppMath.h</ProjectItem><ProjectItem ReplaceParameters="false" TargetFileName="VisualSwift\Invoke-Swift.ps1">VisualSwift\Invoke-Swift.ps1</ProjectItem>
      <ProjectItem ReplaceParameters="false" TargetFileName="VisualSwift\WindowsSwiftEnvironment.ps1">VisualSwift\WindowsSwiftEnvironment.ps1</ProjectItem>
    </Project>
  </TemplateContent>
  <WizardExtension>
    <Assembly>VisualSwift.VisualStudio, Version=1.4.0.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>VisualSwift.SwiftTemplateWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
