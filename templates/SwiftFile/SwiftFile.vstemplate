<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Swift File</Name>
    <Description>An empty Swift source file in the selected SwiftPM source or test target.</Description>
    <Icon>template.ico</Icon>
    <ProjectType>VC</ProjectType>
    <TemplateID>VisualSwift.File</TemplateID>
    <DefaultName>SwiftFile.swift</DefaultName>
    <SortOrder>10</SortOrder>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="false" TargetFileName="$fileinputname$.swift">SwiftFile.swift</ProjectItem>
  </TemplateContent>
  <WizardExtension>
    <Assembly>VisualSwift.VisualStudio, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>VisualSwift.SwiftItemTemplateWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
